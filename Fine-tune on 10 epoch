f\"Saving adapters to {ADAPTERS}...\")\nmodel.save_pretrained(str(ADAPTERS))\ntokenizer.save_pretrained(str(ADAPTERS))\n\n# Metadata\nmetadata = {\n    \"base_model\": CONFIG.model_id,\n    \"framework\": \"unsloth\",\n    \"training\": {\n        \"lora_r\": CONFIG.lora_r,\n        \"lora_alpha\": CONFIG.lora_alpha,\n        \"lora_dropout\": CONFIG.lora_dropout,\n        \"epochs\": CONFIG.epochs,\n        \"effective_batch_size\": 16,\n        \"learning_rate\": CONFIG.learning_rate,\n        \"max_seq_length\": CONFIG.max_seq_length,\n        \"precision\": \"fp16\",\n    },\n    \"data\": {\n        \"source\": CONFIG.dataset_repo,\n    },\n    \"notes\": \"Fine-tuning complete. Transitioning to Post-Eval.\",\n}\n\nwith open(ADAPTERS / \"training_metadata.json\", 'w') as f:\n    json.dump(metadata, f, indent=2)\n\nprint(f\"\\nFiles saved:\")\ntotal_mb = 0\nfor f in sorted(ADAPTERS.iterdir()):\n    size_mb = f.stat().st_size / 1024 / 1024\n    total_mb += size_mb\n    print(f\"  {f.name:45s}  {size_mb:>8.2f} MB\")\nprint(f\"  {'TOTAL':45s}  {total_mb:>8.2f} MB\")\n\nprint(f\"\\n✓ Adapters saved to {ADAPTERS}\")\n\n# ============================================================\n# ==================== END ===================================\n# ============================================================","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-12T15:17:10.576461Z","iopub.execute_input":"2026-05-12T15:17:10.577204Z","iopub.status.idle":"2026-05-12T19:09:29.351734Z","shell.execute_reply.started":"2026-05-12T15:17:10.577157Z","shell.execute_reply":"2026-05-12T19:09:29.350871Z"}},"outputs":[{"name":"stdout","text":"✓ HuggingFace authenticated\n✓ Groq API key loaded\n✓ Environment variables set\n============================================================\nPURE LORA CONFIG LOCKED\n============================================================\n  Model:         unsloth/gemma-4-E2B-it\n  Dataset:       ssiddiquii/car-repair-hq-550\n  LoRA rank: